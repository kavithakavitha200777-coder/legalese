# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# "gemini-1.5-pro" (used in the original docs) has been retired by Google.
# "gemini-flash-latest" always points to the current Flash model. Change if you like.
GEMINI_MODEL=gemini-flash-latest

# Where the Streamlit UI finds the FastAPI backend
BACKEND_URL=http://localhost:8000

# Set to true to test the whole app WITHOUT an API key (returns a built-in template)
MOCK_MODE=false
